# Telegram Bot
BOT_TOKEN=your-telegram-bot-token-here

# OpenAI-compatible API (для коррекции пунктуации)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://192.168.0.250:1234/v1
OPENAI_MODEL=mistral-medium-latest

# Режим "мышления" LLM: off / low / high / max (по умолчанию off — рассуждения выключены)
LLM_REASONING_EFFORT=off
# Тип API: deepseek (top-level thinking) / openai (reasoning_effort).
# Пусто — автоопределение по OPENAI_BASE_URL (если в URL есть "deepseek" — deepseek).
LLM_API_TYPE=

# Прокси (если требуется для Telegram API)
# Формат: "socks5://username:password@proxy-address:port" или "socks5://127.0.0.1:1080"
# Оставьте пустым, если прокси не нужен
PROXY_STRING=socks5://192.168.0.250:2081

# Speech-to-Text провайдер
# google          — Google Speech Recognition (онлайн, бесплатно)
# vosk            — Vosk (локально, ~42MB, хуже качество)
# faster_whisper  — Faster Whisper (локально, CTranslate2, наилучшее качество на слабом железе)
STT_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=small   # tiny / base / small / large-v3-turbo

# Кто может пользоваться ботом (ChatID через запятую; можно несколько)
# Пусто = бот закрыт для всех. Узнать свой ID: напишите @userinfobot
ALLOWED_CHAT_IDS=123456789,987654321

# HTTP health-эндпоинт для UptimeKuma и прочих мониторов
# GET /health -> 200 (бот работает) / 503 (остановлен или ошибка), тело JSON
# GET /stats  -> HTML-дашборд статистики (доступен только при HEALTH_ENABLED=on)
# GET /stats/api -> JSON со статистикой
HEALTH_ENABLED=on
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
